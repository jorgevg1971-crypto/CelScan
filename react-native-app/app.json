{
  "expo": {
    "name": "Escáner Móvil Pro",
    "slug": "scanner-mobil-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.scanner.mobilpro",
      "infoPlist": {
        "NSCameraUsageDescription": "Permitir acceso a la cámara para escanear documentos",
        "NSPhotoLibraryUsageDescription": "Permitir guardar documentos escaneados en fotos y galería"
      }
    },
    "android": {
      "package": "com.scanner.mobilpro",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    }
  }
}
